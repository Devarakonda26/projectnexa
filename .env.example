# ProjectNexa environment template.
# Copy to .env.local for local development. NEVER commit real values.
# In production, set these in your hosting provider's secret manager.

# ---- Public (safe for the browser; prefixed NEXT_PUBLIC_) ----
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-your-anon-key-from-supabase
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Server only (NEVER prefix with NEXT_PUBLIC_) ----
# Bypasses Row Level Security. Used only in server-only modules.
SUPABASE_SERVICE_ROLE_KEY=replace-with-your-service-role-key

# Private storage buckets (created by the SQL migrations)
STORAGE_BUCKET_PRODUCT_FILES=product-files
STORAGE_BUCKET_PAYMENT_PROOFS=payment-proofs
STORAGE_BUCKET_REQUEST_ATTACHMENTS=request-attachments

# Signed download link lifetime in seconds (30-3600)
DOWNLOAD_URL_TTL_SECONDS=120

# Manual payment details displayed to customers at checkout
PAYMENT_UPI_ID=yourbusiness@upi
PAYMENT_UPI_PAYEE_NAME=Your Business Name
PAYMENT_BANK_ACCOUNT_NAME=
PAYMENT_BANK_ACCOUNT_NUMBER=
PAYMENT_BANK_IFSC=
PAYMENT_BANK_NAME=
